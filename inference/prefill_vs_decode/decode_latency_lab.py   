    print("======================= Aggregated Results =======================")
    header = (
        f"{'L':>7} "
        f"{'median ms':>12} "
        f"{'p95 ms':>12} "
        f"{'decode tok/s':>15} "
        f"{'total MACs':>14} "
        f"{'KV bytes':>12}"
    )
    print(header)
    print("-" * len(header))
    for result in results:
        print(
            f"{result.context_length:7,d} "
            f"{result.median_ms:12.4f} "
            f"{result.p95_ms:12.4f} "
            f"{result.median_decode_tokens_per_second:15,.1f} "
            f"{macs_to_human(result.accounting.total_macs):>14} "
            f"{bytes_to_human(result.accounting.logical_kv_bytes):>12}"
        )
    print("=================================================================\n")


def save_results_csv(results: Sequence[BenchmarkResult], path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", newline="") as handle:
        writer = csv.writer(handle)
        writer.writerow(
            [
                "context_length",
                "median_ms",
                "p95_ms",
                "median_decode_tokens_per_second",
                "projection_macs",
                "attention_score_macs",
                "attention_value_macs",
                "attention_macs",
                "total_macs",
                "logical_kv_elements",
                "logical_kv_bytes",
                "logical_score_elements",
                "logical_score_bytes",
                "logical_kv_write_bytes",
            ]
        )
        for result in results:
            a = result.accounting
            writer.writerow(
                [
                    result.context_length,
                    f"{result.median_ms:.9f}",
                    f"{result.p95_ms:.9f}",
                    f"{result.median_decode_tokens_per_second:.6f}",
                    a.projection_macs,
                    a.attention_score_macs,
                    a.attention_value_macs,
                    a.attention_macs,
                    a.total_macs,
                    a.logical_kv_elements,
                    a.logical_kv_bytes,
                    a.logical_score_elements,
                    a.logical_score_bytes,
                    a.logical_kv_write_bytes,
                ]
            )


def plot_latency(results: Sequence[BenchmarkResult], path: Path) -> None:
    x = [r.context_length for r in results]
    median = [r.median_ms for r in results]
    p95 = [r.p95_ms for r in results]
    plt.figure(figsize=(8, 5))
    plt.plot(x, median, marker="o", label="median")
    plt.plot(x, p95, marker="o", label="p95")
    plt.xlabel("KV length L")
    plt.ylabel("Latency per decode step (ms)")
    plt.title("Decode Latency vs. KV-Cache Length")
    plt.grid(True, alpha=0.3)
    plt.legend()
    plt.tight_layout()
    plt.savefig(path, dpi=160)
    plt.close()


def plot_throughput(results: Sequence[BenchmarkResult], path: Path) -> None:
    x = [r.context_length for r in results]
    y = [r.median_decode_tokens_per_second for r in results]
    plt.figure(figsize=(8, 5))
    plt.plot(x, y, marker="o")
    plt.xlabel("KV length L")
    plt.ylabel("Decode tokens/s")
    plt.title("Decode Throughput vs. KV-Cache Length")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(path, dpi=160)
    plt.close()


def plot_log_log_fit(
    results: Sequence[BenchmarkResult],
    alpha: float,
    coefficient: float,
    r_squared: float,
    path: Path,
) -> None:
    x = [r.context_length for r in results]
    y = [r.median_ms for r in results]
    fitted = [coefficient * (value ** alpha) for value in x]
    plt.figure(figsize=(8, 5))
    plt.loglog(x, y, marker="o", label="measured median")
    plt.loglog(
        x,
        fitted,
        linestyle="--",
        label=f"fit: latency ∝ L^{alpha:.3f}, R²={r_squared:.4f}",
    )
    plt.xlabel("KV length L (log scale)")
    plt.ylabel("Latency per decode step, ms (log scale)")
    plt.title("Decode Latency Scaling — Log-Log Fit")
    plt.grid(True, which="both", alpha=0.3)
    plt.legend()
    plt.tight_layout()
    plt.savefig(path, dpi=160)
    plt.close()


def parse_context_lengths(raw_value: str) -> List[int]:
    try:
        values = [int(item.strip()) for item in raw_value.split(",") if item.strip()]
    except ValueError as exc:
        raise argparse.ArgumentTypeError(
            "context lengths must be comma-separated integers"
        ) from exc
    if not values:
        raise argparse.ArgumentTypeError("provide at least one context length")
    if any(value <= 0 for value in values):
        raise argparse.ArgumentTypeError("context lengths must be positive")
    if len(set(values)) != len(values):
        raise argparse.ArgumentTypeError("context lengths must not contain duplicates")
    if values != sorted(values):
        raise argparse.ArgumentTypeError("context lengths must be increasing")
    return values


def resolve_device(requested: str) -> str:
    if requested != "auto":
        if requested == "cuda" and not torch.cuda.is_available():
            raise RuntimeError("CUDA requested but torch.cuda.is_available() is false")
        if requested == "mps" and not torch.backends.mps.is_available():
            raise RuntimeError("MPS requested but torch.backends.mps.is_available() is false")
        return requested
    if torch.cuda.is_available():
        return "cuda"
    if torch.backends.mps.is_available():
        return "mps"
    return "cpu"


def resolve_dtype(requested: str, device: str) -> torch.dtype:
    if requested == "auto":
        return torch.float16 if device == "cuda" else torch.float32
    mapping = {
        "float16": torch.float16,
        "bfloat16": torch.bfloat16,
        "float32": torch.float32,
        "float64": torch.float64,
    }
    dtype = mapping[requested]
    if device == "cpu" and dtype == torch.float16:
        raise ValueError(
            "float16 CPU matrix multiplication is often unsupported or very slow; "
            "use float32/bfloat16 or run on CUDA"
        )
    return dtype


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Measure one-token decode latency as KV-cache length increases."
    )
    parser.add_argument(
        "--context-lengths",
        type=parse_context_lengths,
        default=parse_context_lengths("512,1024,2048,4096,8192"),
        help="increasing comma-separated KV lengths; L includes current token",
    )
    parser.add_argument("--embed-dim", type=int, default=512)
    parser.add_argument("--num-heads", type=int, default=8)
    parser.add_argument("--batch-size", type=int, default=1)
    parser.add_argument("--vocab-size", type=int, default=32_000)
    parser.add_argument("--warmups", type=int, default=5)
    parser.add_argument("--runs", type=int, default=30)
    parser.add_argument("--seed", type=int, default=7)
    parser.add_argument(
        "--device", choices=["auto", "cpu", "cuda", "mps"], default="auto"
    )
    parser.add_argument(
        "--dtype",
        choices=["auto", "float16", "bfloat16", "float32", "float64"],
        default="auto",
    )
    parser.add_argument(
        "--torch-threads", type=int, default=1, help="CPU-only PyTorch thread count"
    )
    parser.add_argument("--out-dir", type=Path, default=Path("decode_outputs"))
    parser.add_argument(
        "--skip-plots",
        action="store_true",
        help="skip PNG generation; useful for clean Nsight captures",
    )
    return parser


def validate_args(args: argparse.Namespace) -> None:
    if args.embed_dim <= 0:
        raise ValueError("embed_dim must be positive")
    if args.num_heads <= 0:
        raise ValueError("num_heads must be positive")
    if args.embed_dim % args.num_heads != 0:
        raise ValueError("embed_dim must be divisible by num_heads")
    if args.batch_size <= 0:
        raise ValueError("batch_size must be positive")
    if args.vocab_size <= 1:
        raise ValueError("vocab_size must be greater than 1")
    if args.warmups < 0:
        raise ValueError("warmups must be non-negative")
    if args.runs <= 0:
        raise ValueError("runs must be positive")
    if args.torch_threads <= 0:
        raise ValueError("torch_threads must be positive")


def run_experiment(args: argparse.Namespace) -> List[BenchmarkResult]:
    validate_args(args)
    device = resolve_device(args.device)
    dtype = resolve_dtype(args.dtype, device)
    if device == "cpu":
        torch.set_num_threads(args.torch_threads)

    cfg = LabConfig(
        embed_dim=args.embed_dim,
        num_heads=args.num_heads,
        batch_size=args.batch_size,
        vocab_size=args.vocab_size,
        dtype=dtype,
        device=device,
    )
    print_configuration(cfg, args.context_lengths, args.warmups, args.runs)

    model = DecodeAttentionBlock(cfg, seed=args.seed)
    token_ids = make_token_ids(
        batch_size=cfg.batch_size,
        vocab_size=cfg.vocab_size,
        device=cfg.device,
        seed=args.seed + 10_000,
    )

    results: List[BenchmarkResult] = []
    for context_length in args.context_lengths:
        k_cache, v_cache = make_synthetic_kv_cache(
            cfg=cfg,
            context_length=context_length,
            seed=args.seed + 20_000,
        )
        median_ms, p95_ms = benchmark_context_length(
            model=model,
            token_ids=token_ids,
            k_cache=k_cache,
            v_cache=v_cache,
            warmups=args.warmups,
            runs=args.runs,
        )
        accounting = calculate_decode_accounting(
            batch_size=cfg.batch_size,
            context_length=context_length,
            embed_dim=cfg.embed_dim,
            num_heads=cfg.num_heads,
            dtype_bytes=cfg.dtype_bytes,
        )
        median_decode_tokens_per_second = cfg.batch_size * 1000.0 / median_ms
        results.append(
            BenchmarkResult(
                context_length=context_length,
                median_ms=median_ms,
                p95_ms=p95_ms,
                median_decode_tokens_per_second=median_decode_tokens_per_second,
                accounting=accounting,
            )
        )
    return results


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    results = run_experiment(args)
    print_results(results)

    args.out_dir.mkdir(parents=True, exist_ok=True)
    csv_path = args.out_dir / "decode_results.csv"
    save_results_csv(results, csv_path)
    print(f"Saved aggregated CSV:\n  {csv_path}")

    if not args.skip_plots:
        latency_path = args.out_dir / "decode_latency_vs_context_length.png"
        throughput_path = args.out_dir / "decode_throughput_vs_context_length.png"
        plot_latency(results, latency_path)
        plot_throughput(results, throughput_path)
        print("Saved plots:")
        print(f"  {latency_path}")
        print(f"  {throughput_path}")

    if len(results) >= 2:
        context_lengths = [result.context_length for result in results]
        median_latencies = [result.median_ms for result in results]
        alpha, coefficient, r_squared = fit_power_law(
            context_lengths, median_latencies
        )
        print("\n==================== Empirical Scaling Fit ====================")
        print(f"median latency ≈ {coefficient:.6g} × L^{alpha:.3f}")
        print(f"R²             = {r_squared:.4f}")
        print("Interpretation: alpha near 0 is approximately constant;")
        print("near 1 is approximately linear in KV length.")
        print("===============================================================\n")

        if not args.skip_plots:
            log_log_path = args.out_dir / "decode_latency_loglog_fit.png"
            plot_log_log_fit(
                results, alpha, coefficient, r_squared, log_log_path
            )
            print(f"  {log_log_path}")
    else:
        print("\nScaling fit skipped: at least two context lengths are required.")

    print("Individual timing samples are not saved.")


if __name__ == "__main__":
    main()
